# LLM
DEEPSEEK_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# PostgreSQL (M4+) —— 会话持久化接入自建 PG17（替代 Supabase）
DATABASE_URL=postgresql://ddd:ddd@localhost:5432/fedrill
# 客户端开关：置 1 时 getSessionRepo() 返回 HTTP 实现（走 API 桥接）
NEXT_PUBLIC_USE_POSTGRES=1

# Supabase (M4+ 备选，已弃用，保留参考)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (M4+)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Piston (M3+)
PISTON_API_URL=https://emkc.org/api/v2/piston

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# GitHub OAuth (M5 Phase 3) —— 需在 GitHub 注册 OAuth App：
#   Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL: http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 回调基址（本地开发 http://localhost:3000；部署后换域名）
APP_BASE_URL=http://localhost:3000
