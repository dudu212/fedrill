{
  "name": "@fedrill/mcp",
  "version": "0.2.0",
  "description": "FEDrill 手撕题库 MCP Server —— 让 Claude Desktop / Codex / Cursor 等 MCP 客户端挂载 FEDrill 题库",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fedrill-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/judge-worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --outbase=src --target=node18",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
